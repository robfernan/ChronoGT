<resources>
    <properties>
        <property id="AccentTheme" type="number">0</property>
        <property id="GaugeMode" type="number">0</property>
        <property id="ShowShiftLights" type="boolean">true</property>
        <property id="LayoutMode" type="number">0</property>
        <property id="RedlinePulse" type="boolean">true</property>
        <property id="MetricSlotA" type="number">0</property>
        <property id="MetricSlotB" type="number">5</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.LayoutMode" title="@Strings.LayoutTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.LayoutClassic</listEntry>
                <listEntry value="1">@Strings.LayoutRibbon</listEntry>
                <listEntry value="2">@Strings.LayoutSegmented</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.AccentTheme" title="@Strings.ThemeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ThemeAmber</listEntry>
                <listEntry value="1">@Strings.ThemeRed</listEntry>
                <listEntry value="2">@Strings.ThemeCyan</listEntry>
                <listEntry value="3">@Strings.ThemeGreen</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.GaugeMode" title="@Strings.GaugeModeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.GaugeSeconds</listEntry>
                <listEntry value="1">@Strings.GaugeSteps</listEntry>
                <listEntry value="2">@Strings.GaugeHR</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.ShowShiftLights" title="@Strings.ShowShiftLightTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.RedlinePulse" title="@Strings.RedlinePulseTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.MetricSlotA" title="@Strings.MetricSlotATitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.MetricBattery</listEntry>
                <listEntry value="1">@Strings.MetricSteps</listEntry>
                <listEntry value="2">@Strings.MetricRemaining</listEntry>
                <listEntry value="3">@Strings.MetricCalories</listEntry>
                <listEntry value="4">@Strings.MetricDistance</listEntry>
                <listEntry value="5">@Strings.MetricHR</listEntry>
                <listEntry value="6">@Strings.MetricNone</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.MetricSlotB" title="@Strings.MetricSlotBTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.MetricBattery</listEntry>
                <listEntry value="1">@Strings.MetricSteps</listEntry>
                <listEntry value="2">@Strings.MetricRemaining</listEntry>
                <listEntry value="3">@Strings.MetricCalories</listEntry>
                <listEntry value="4">@Strings.MetricDistance</listEntry>
                <listEntry value="5">@Strings.MetricHR</listEntry>
                <listEntry value="6">@Strings.MetricNone</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
